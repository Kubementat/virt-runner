#!/usr/bin/env bash
#
# vm-create — download a cached Ubuntu cloud image, generate cloud-init
# files, and create+boot a KVM VM on the libvirt `default` NAT network.
#
# See ../specification/specification.md for the full contract:
#   - CLI: vm-create <NAME> [OPTIONS]  (spec §3.1)
#   - Pipeline: preflight → image → cloud-init → virt-install → IP → ssh (spec §4)
#   - Exit codes: 0 = success, 1 = runtime/preflight failure, 2 = usage error
#
# Test-only environment hooks (documented per plan ground rule 5):
#   VM_CREATE_CACHE_DIR  Relocate the image cache directory (default ~/vm-images).
#                        Honored by fetch_and_verify_image (ticket 02).
#   VM_CREATE_LEASE_FILE Relocate the dnsmasq lease file
#                        (default /var/lib/libvirt/dnsmasq/virbr0.status).
#   VM_CREATE_CLOUD_INIT_DUMP  Copy the generated cloud-init user-data and
#                        meta-data files into this directory before the EXIT
#                        trap removes the temp dir (test-only, ticket 03).
#
# Safety: only `poc-`-prefixed names are used in tests; this script never
# touches `setup-test-vm` or any pre-existing volume.

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants (defaults per spec §3.1)
# ---------------------------------------------------------------------------
RAM=4                                   # --ram, GiB
VCPUS=2                                 # --vcpu
DISK=30                                 # --disk, GiB
RELEASE=resolute                        # --release
USER_NAME=ubuntu                        # --user
SSHKEY="$HOME/.ssh/id_ed25519.pub"      # --ssh-key (D10: dot is required)
POOL=vm-pool                            # libvirt storage pool
NET=default                             # libvirt network
# dnsmasq lease file; overridable for fixture tests (plan ground rule 5).
LEASE_FILE="${VM_CREATE_LEASE_FILE:-/var/lib/libvirt/dnsmasq/virbr0.status}"

# Default image/sums URLs (spec §5, release `resolute`).
IMAGE_BASE_URL="https://cloud-images.ubuntu.com"
IMAGE_URL="${IMAGE_BASE_URL}/${RELEASE}/current/${RELEASE}-server-cloudimg-amd64.img"
SUMS_URL="${IMAGE_BASE_URL}/${RELEASE}/current/SHA256SUMS"

NAME=""
NO_BOOT=0
KEEP_GOING=0
RELEASE_GIVEN=0
IMAGE_GIVEN=0
IMAGE_ARG=""

# ---------------------------------------------------------------------------
# Usage / error helpers
# ---------------------------------------------------------------------------
usage() {
  cat >&2 <<EOF
Usage: vm-create <NAME> [OPTIONS]

Create and boot an Ubuntu KVM VM via libvirt (qemu:///system) on the
default NAT network, with the disk in the '${POOL}' storage pool.

NAME must match ^[A-Za-z][A-Za-z0-9._-]*\$ and must not be an
already-defined domain.

Options (defaults in parentheses):
  --ram GiB        Guest RAM in GiB, positive integer   (default: ${RAM})
  --vcpu N         vCPU count, positive integer         (default: ${VCPUS})
  --disk GiB       Virtual disk size in GiB, positive integer (default: ${DISK})
  --release REL    Release codename; selects the standard image/SHA256SUMS
                   URLs and overrides --image if both are given (D1)
                   (default: ${RELEASE})
  --image URL      Direct URL of a raw cloud image; overrides the default
                   release image, unless --release is also given
                   (default: ${IMAGE_URL})
  --user USER      Cloud user name to create and SSH as (default: ${USER_NAME})
  --ssh-key PATH   Path to the public key to inject (default: ~/.ssh/id_ed25519.pub)
  --no-boot        Create the VM but do not boot / wait for IP (default: off)
  --keep-going     On download/verify error, continue if a cached image exists
                   (default: off)

Exit codes: 0 success, 1 runtime/preflight failure, 2 usage error.
EOF
}

die_usage() {
  echo "vm-create: $*" >&2
  usage
  exit 2
}

die() {
  echo "vm-create: $*" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
take_name() { # $1 = candidate NAME; caller shifts afterwards
  if [[ -z "$NAME" ]]; then
    NAME="$1"
  else
    die_usage "unexpected argument: $1"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ram)
      [[ $# -ge 2 ]] || die_usage "option --ram requires a value"
      RAM="$2"; shift 2 ;;
    --vcpu)
      [[ $# -ge 2 ]] || die_usage "option --vcpu requires a value"
      VCPUS="$2"; shift 2 ;;
    --disk)
      [[ $# -ge 2 ]] || die_usage "option --disk requires a value"
      DISK="$2"; shift 2 ;;
    --release)
      [[ $# -ge 2 ]] || die_usage "option --release requires a value"
      RELEASE="$2"; RELEASE_GIVEN=1; shift 2 ;;
    --image)
      [[ $# -ge 2 ]] || die_usage "option --image requires a value"
      IMAGE_ARG="$2"; IMAGE_GIVEN=1; shift 2 ;;
    --user)
      [[ $# -ge 2 ]] || die_usage "option --user requires a value"
      USER_NAME="$2"; shift 2 ;;
    --ssh-key)
      [[ $# -ge 2 ]] || die_usage "option --ssh-key requires a value"
      SSHKEY="$2"; shift 2 ;;
    --no-boot)
      NO_BOOT=1; shift ;;
    --keep-going)
      KEEP_GOING=1; shift ;;
    -*)
      # Only long options (--...) are defined. A single-dash argument is
      # treated as a NAME candidate and rejected by the name regex below
      # (spec §3.1: names must not start with '-').
      if [[ "$1" == --* ]]; then
        die_usage "unknown option: $1"
      fi
      take_name "$1"; shift ;;
    *)
      take_name "$1"; shift ;;
  esac
done

# --release/--image precedence (decision D1): when --release is given it
# wins over --image, regardless of order on the command line. The release
# selects the standard image + SHA256SUMS URL pattern (spec §5).
if [[ "$RELEASE_GIVEN" -eq 1 ]]; then
  IMAGE_URL="${IMAGE_BASE_URL}/${RELEASE}/current/${RELEASE}-server-cloudimg-amd64.img"
  SUMS_URL="${IMAGE_BASE_URL}/${RELEASE}/current/SHA256SUMS"
elif [[ "$IMAGE_GIVEN" -eq 1 ]]; then
  IMAGE_URL="$IMAGE_ARG"
  SUMS_URL=""
fi

[[ -n "$NAME" ]] || die_usage "missing NAME"

# NAME validation (spec §4 step 1; usage error → exit 2).
if ! [[ "$NAME" =~ ^[A-Za-z][A-Za-z0-9._-]*$ ]]; then
  die_usage "invalid VM name '$NAME': must match ^[A-Za-z][A-Za-z0-9._-]*\$"
fi

# Positive-integer validation for numeric options.
for pair in "ram:${RAM}" "vcpu:${VCPUS}" "disk:${DISK}"; do
  label="${pair%%:*}"; value="${pair#*:}"
  if ! [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
    die_usage "--${label} must be a positive integer (got '${value}')"
  fi
done

# ---------------------------------------------------------------------------
# Step 1 — Preflight checks (spec §4 step 1). Each failure: one line on
# stderr naming the check, exit 1.
# ---------------------------------------------------------------------------

# 1. libvirt reachable (socket-activated libvirtd; do NOT check systemctl —
#    spec §6 pitfall 8).
if ! virsh list >/dev/null 2>&1; then
  die "preflight failed: libvirt not reachable ('virsh list' failed)"
fi

# 2. Domain NAME not already defined (suppress virsh dominfo's stderr).
if virsh dominfo "$NAME" >/dev/null 2>&1; then
  die "VM '${NAME}' already defined"
fi

# 3. Storage pool active.
if ! virsh pool-list --all 2>/dev/null | awk -v p="$POOL" '$1 == p && $2 == "active" { found = 1 } END { exit !found }'; then
  die "preflight failed: storage pool '${POOL}' is not active"
fi

# 4. Network active.
if ! virsh net-list --all 2>/dev/null | awk -v n="$NET" '$1 == n && $2 == "active" { found = 1 } END { exit !found }'; then
  die "preflight failed: network '${NET}' is not active"
fi

# 5. SSH key file exists and is non-empty.
if [[ ! -s "$SSHKEY" ]]; then
  die "ssh key not found: ${SSHKEY}"
fi

# ---------------------------------------------------------------------------
# Step 2 — Image download + SHA256 verification + cache reuse (spec §4 step 2,
# decisions D1 + D4). Honors the testability hook VM_CREATE_CACHE_DIR (plan
# ground rule 5); the default cache root stays $HOME/vm-images.
#
#   --release path (or default release):  <cache>/<release>/<rel>-...amd64.img
#   bare --image path (no --release):     <cache>/custom/<url-basename>
#
# D4: the image is fetched directly to the FINAL name (SHA256SUMS lists the
#     final name) and verified in place; on any failure the file is removed.
# D1: a bare --image verifies only if a same-directory SHA256SUMS is
#     derivable (file:// or http(s)); otherwise verification is skipped and a
#     warning is printed.
# ---------------------------------------------------------------------------
fetch_and_verify_image() {
  local cache_root="${VM_CREATE_CACHE_DIR:-$HOME/vm-images}"
  local cache_dir img_basename sums_url scheme verifiable

  if [[ "$RELEASE_GIVEN" -eq 1 || "$IMAGE_GIVEN" -eq 0 ]]; then
    # --release (or default release): standard URL pattern + SHA256SUMS.
    cache_dir="$cache_root/$RELEASE"
    img_basename="$RELEASE-server-cloudimg-amd64.img"
    sums_url="$SUMS_URL"
    verifiable=1
  else
    # bare --image (D1): cache under custom/ using the URL basename.
    cache_dir="$cache_root/custom"
    img_basename="${IMAGE_URL##*/}"
    sums_url="${IMAGE_URL%/*}/SHA256SUMS"
    scheme="${IMAGE_URL%%://*}"
    if [[ "$scheme" == "file" || "$scheme" == "http" || "$scheme" == "https" ]]; then
      verifiable=1
    else
      verifiable=0
    fi
  fi

  local img="$cache_dir/$img_basename"
  # Global so step 4 can use it as the local --location source path.
  IMAGE_LOCAL_PATH="$img"
  mkdir -p "$cache_dir"

  # -- Cache hit (spec §4 step 2; AC2): skip download and sums entirely.
  if [[ -f "$img" ]]; then
    if [[ "$KEEP_GOING" -eq 1 ]]; then
      echo "vm-create: warning: reusing cached image (no download): $img" >&2
    fi
    echo "image ready: $img"
    return 0
  fi

  local img_ok=1 fail_msg=""

  # -- Download (D4): fetch directly to the FINAL name in the cache dir.
  #    file:// uses a local cp fast-path (reliable, no curl file:// quirks);
  #    everything else uses curl.
  if [[ "$IMAGE_URL" == file://* ]]; then
    local src="${IMAGE_URL#file://}"
    if ! cp -f "$src" "$img" 2>/dev/null; then
      img_ok=0; fail_msg="download failed: $IMAGE_URL"
    fi
  else
    if ! curl -fL --retry 3 -o "$img" "$IMAGE_URL" 2>/dev/null; then
      img_ok=0; fail_msg="download failed: $IMAGE_URL"
    fi
  fi

  if [[ "$img_ok" -eq 1 && "$verifiable" -eq 1 ]]; then
    # -- Fetch the same-directory SHA256SUMS.
    local sums_ok=0
    if [[ "$sums_url" == file://* ]]; then
      local ssrc="${sums_url#file://}"
      if [[ -f "$ssrc" ]]; then cp -f "$ssrc" "$cache_dir/SHA256SUMS" 2>/dev/null && sums_ok=1; fi
    else
      if curl -fsL "$sums_url" -o "$cache_dir/SHA256SUMS" 2>/dev/null; then sums_ok=1; fi
    fi

    if [[ "$sums_ok" -eq 0 ]]; then
      # D1: no derivable same-directory SHA256SUMS -> skip verification, warn.
      echo "vm-create: warning: no same-directory SHA256SUMS for $IMAGE_URL; skipping verification" >&2
    else
      # -- Verify in place against the final filename (D4). Guard the pipeline
      #    so "not in sums" (grep exit 1) and a hash mismatch both surface as a
      #    clear error rather than a bare set -e abort (pipefail propagates).
      local verify_out
      if ! verify_out="$(cd "$cache_dir" && grep -F "$img_basename" SHA256SUMS 2>/dev/null | sha256sum -c - 2>&1)"; then
        echo "$verify_out" >&2
        img_ok=0
        fail_msg="SHA256 mismatch for $img"
      fi
    fi
  fi

  # -- Failure handling (spec §4 step 2.4 / §3.1): remove the partial/corrupt
  #    file, then apply --keep-going semantics.
  if [[ "$img_ok" -ne 1 ]]; then
    rm -f "$img"
    if [[ "$KEEP_GOING" -eq 1 && -f "$img" ]]; then
      # A good cached image survives at the final path -> continue with it.
      echo "vm-create: warning: $fail_msg; continuing with cached image $img" >&2
      echo "image ready: $img"
      return 0
    fi
    if [[ "$KEEP_GOING" -eq 1 ]]; then
      die "keep-going: $fail_msg; no cached image to continue with"
    fi
    die "$fail_msg"
  fi

  echo "image ready: $img"
  return 0
}

# Run the download/verify step now that preflight has passed.
fetch_and_verify_image

# ---------------------------------------------------------------------------
# Step 3 — Cloud-init user-data / meta-data generation (spec §4 step 3,
# decisions D2 + D3).
#
#   - Both files are written into a fresh `mktemp -d` directory (NEVER a
#     static path); the dir is chmod 700, both files chmod 600.
#   - A trap on EXIT removes the temp dir so it never survives.
#   - Test-only dump hook (plan §2, S3): if VM_CREATE_CLOUD_INIT_DUMP is set,
#     both files are copied into that directory BEFORE the EXIT trap removes
#     the temp dir, so the generated content can be inspected after the run.
#
#   D3: `local:` and `host:` sit at IDENTICAL indentation under `hostnames:`
#       (the research doc had a stray-indent bug that produced invalid
#       NoCloud — do not repeat it).
#   D2: the `--user` value (default `ubuntu`) flows verbatim into the
#       `users: - name:` entry.
#   Pitfall 5: NO `network:` section / no network-config is ever emitted; the
#       image's default DHCP-on-first-NIC is relied upon.
#
# NOTE: CLOUD_INIT_TMP is intentionally global (not local) so the EXIT trap
# can still see it when it fires after the function has returned.
# ---------------------------------------------------------------------------
generate_cloud_init_files() {
  CLOUD_INIT_TMP="$(mktemp -d)"
  chmod 700 "$CLOUD_INIT_TMP"
  trap 'rm -rf "${CLOUD_INIT_TMP:-}"' EXIT

  local uuid ssh_key_line
  # Fresh lowercase UUID on EVERY run (uuidgen may emit uppercase; force lower).
  uuid="$(uuidgen | tr 'A-Z' 'a-z')"
  # Full single-line content of the --ssh-key file (non-empty guaranteed by the
  # ticket-01 preflight). $(<file) strips the trailing newline.
  ssh_key_line="$(<"$SSHKEY")"

  # DEVIATION (ticket 05, verified live): the NoCloud datasource consumes the
  # hostname from `local-hostname:` — the `hostnames:` dict below (EC2
  # identity format, kept for spec §3.1 conformance) is IGNORED by NoCloud,
  # which is why the first real boot kept the image default hostname
  # `ubuntu`. `local-hostname:` is mandatory for the §5 `<NAME>.default`
  # DNS name (dnsmasq takes the hostname from the DHCP lease).
  cat > "$CLOUD_INIT_TMP/meta-data" <<EOF
id: $uuid
local-hostname: $NAME
hostnames:
  local: $NAME
  host: $NAME
EOF

  cat > "$CLOUD_INIT_TMP/user-data" <<EOF
#cloud-config
manage_etc_hosts: true
users:
  - name: $USER_NAME
    groups: [sudo]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - $ssh_key_line
package_update: false
EOF

  chmod 600 "$CLOUD_INIT_TMP/user-data" "$CLOUD_INIT_TMP/meta-data"

  # Test-only dump hook: copy both files out BEFORE the EXIT trap removes
  # $CLOUD_INIT_TMP. Must happen before any exit.
  if [[ -n "${VM_CREATE_CLOUD_INIT_DUMP:-}" ]]; then
    mkdir -p "$VM_CREATE_CLOUD_INIT_DUMP"
    cp "$CLOUD_INIT_TMP/meta-data" "$CLOUD_INIT_TMP/user-data" "$VM_CREATE_CLOUD_INIT_DUMP/"
  fi

  echo "cloud-init files generated: $CLOUD_INIT_TMP (meta-data, user-data; id=$uuid)"
}

# Run the cloud-init generation step now that the image is ready.
generate_cloud_init_files

# ---------------------------------------------------------------------------
# Step 4 — VM creation via `virt-install --import` (spec §4 step 4, decision
# D5). Rationale per flag (spec §4 step 4 table):
#   --disk vol=vm-pool/<NAME>_vda.qcow2  full qcow2 in vm-pool, named
#                                        <NAME>_vda.qcow2 (spec §5 contract,
#                                        which vm-destroy relies on)
#   --network ...mac=$MAC                fixed, known-before-boot MAC so the
#                                        step-5 lease match is deterministic
#   --os-variant ubuntu-lts-latest       osinfo-db gap workaround (pitfall 6)
#   --import                             byte-copy the raw image, NO installer
#   --console none                       unattended; still debuggable via
#                                        `virsh console` — Ubuntu cloud
#                                        images ship a serial getty on ttyS0.
#   NOTE: the spec's `--extra-args console=ttyS0` is REJECTED by virt-install
#         4.1.0 here ("Kernel arguments are only supported with location or
#         kernel installs") when booting a plain imported volume, so it is
#         omitted; the image's own serial console covers the same debug path.
#   --cloud-init "user-data=,meta-data=,clouduser-ssh-key=,disable=on"
#                                        file-based NoCloud sub-options ONLY
#                                        (virt-install 4.1.0). `disable=on`
#                                        is MANDATORY (pitfall 3); bare
#                                        `--cloud-init` is forbidden
#                                        (pitfall 4: root-password-generate).
#   --autostart                          VM survives host reboots.
#
# DEVIATION (ticket 05, verified live on this host, virt-install 4.1.0):
# the spec's verbatim `--location $IMAGE --import` + `--disk size=…` shape
# does NOT work with a raw disk image — virt-install 4.1.0 hard-fails with
# "Error validating install location: Could not find an installable
# distribution" (it probes --location as an install tree). It also names
# self-created pool volumes '<NAME>.qcow2' (see
# _generate_new_volume_name in virtinst/cli.py), which would violate the
# '<NAME>_vda.qcow2' naming contract. Semantically equivalent flow used
# instead: (1) create the pool volume with the contract name,
# (2) `virsh vol-upload` the raw image into it (byte copy, exactly what
# --import --location would do), (3) hand virt-install the existing volume
# with `--import` (no installer, boots straight from the image).
# ---------------------------------------------------------------------------

VOLUME="${NAME}_vda.qcow2"

if ! virsh vol-create-as "$POOL" "$VOLUME" --capacity "${DISK}G" --format qcow2 >/dev/null 2>&1; then
  die "failed to create pool volume '${VOLUME}' in pool '${POOL}'"
fi

if ! virsh vol-upload --pool "$POOL" "$VOLUME" "$IMAGE_LOCAL_PATH" >/dev/null 2>&1; then
  virsh --quiet vol-delete "$VOLUME" "$POOL" 2>/dev/null || true
  die "failed to import image into pool volume '${VOLUME}'"
fi

# MAC scheme (spec §5): 52:54:00:<3 random hex bytes>, generated once per run.
# NOTE: the spec's literal one-liner emits the 3 random bytes as a bare hex
# tail (52:54:00:24d2bd), which libvirt rejects ("unable to parse mac
# address"). Same scheme, colon-separated per group of 2 hex chars — the
# result still matches the accepted form 52:54:00:xxxxxx (see ticket 04
# report; deviation recorded).
MAC_TAIL="$(head -c3 /dev/urandom | od -An -tx1 | tr -d ' \n')"
MAC="52:54:00:${MAC_TAIL:0:2}:${MAC_TAIL:2:2}:${MAC_TAIL:4:2}"

# GiB -> MiB conversion for --ram. DEVIATION (ticket 05, verified live):
# virt-install 4.1.0's --ram/--memory take MIB, not KiB (the spec's
# "GiB→KiB" assumption allocates RAM*1024 times too much — the first real
# boot got a 2 TiB guest, which stalled for minutes in early memory init).
RAM_MIB=$((RAM * 1024))

if ! virt-install \
  --name "$NAME" \
  --ram "$RAM_MIB" --vcpu "$VCPUS" \
  --disk "vol=${POOL}/${VOLUME},bus=virtio" \
  --network "network=${NET},model=virtio,mac=${MAC}" \
  --os-variant ubuntu-lts-latest \
  --import \
  --console none \
  --cloud-init "user-data=${CLOUD_INIT_TMP}/user-data,meta-data=${CLOUD_INIT_TMP}/meta-data,clouduser-ssh-key=${SSHKEY},disable=on" \
  --autostart; then
  # Never leave an orphan volume behind on failure.
  virsh --quiet destroy "$NAME" 2>/dev/null || true
  virsh --quiet undefine "$NAME" 2>/dev/null || true
  virsh --quiet vol-delete "$VOLUME" "$POOL" 2>/dev/null || true
  die "virt-install failed for '${NAME}' (see errors above); no VM left behind"
fi

echo "VM '${NAME}' created (assigned MAC: ${MAC})"

# ---------------------------------------------------------------------------
# Decision D5 — `--no-boot`: stop-after-create. virt-install auto-starts the
# domain, so guard the destroy with a domstate check: if the domain is
# already shut off, the guarded branch is skipped and `set -e` does not abort.
# ---------------------------------------------------------------------------
if [[ "$NO_BOOT" -eq 1 ]]; then
  if [[ "$(virsh domstate "$NAME" 2>/dev/null)" == "running" ]]; then
    virsh --quiet destroy "$NAME"
  fi
  echo "VM created (not booted): ${NAME}"
  echo "Console: virsh console ${NAME}     (Ctrl-] to detach)"
  echo "Teardown: vm-destroy ${NAME}   (or: virsh destroy ${NAME} && virsh undefine ${NAME})"
  exit 0
fi

# ---------------------------------------------------------------------------
# Step 5 — wait for IP (dnsmasq lease-file polling) + mandatory SSH
# verification (spec §4 step 5; decisions D6 + D8).
#
#   Primary source: the libvirt dnsmasq lease file $LEASE_FILE (overridable
#   via VM_CREATE_LEASE_FILE, plan ground rule 5).
#
#   CONFIRMED FORMAT (ticket 05, real first boot, this host's libvirt/
#   dnsmasq — the file the spec assumed to be `<ip> <mac> <hostname>`
#   columns is actually): a pretty-printed JSON array, one object per
#   lease, values on SEPARATE lines:
#     [
#       {
#         "ip-address": "192.168.122.156",
#         "mac-address": "52:54:00:ee:95:a7",   # lowercase
#         "hostname": "poc-s5",
#         "client-id": "ff:56:50:4d:98:00:02:00:00:...",
#         "expiry-time": 1787682480
#       },
#       ...
#     ]
#   find_ip_for_mac parses this with jq (python3 fallback). A line-based
#   column parser can NEVER match this format (MAC and IP are on different
#   lines). For compatibility with the fixture-pinned contract (and older
#   dnsmasq/libvirt variants), the legacy space-separated format
#   `<ip> <mac> [<hostname>]` (2- or 3-column) is still parsed: the MAC
#   field is matched case-insensitively (awk tolower on the file side, tr
#   on the query side; a MAC with no preceding field is skipped, so
#   degenerate lines are ignored non-fatally) and the field immediately
#   before it (the IP) is returned.
#
#   NOTE: the file may contain leases of OTHER domains (stale entries of
#   deleted VMs persist until renewed/expired) — the strict per-MAC match
#   (MACs are unique per VM, fixed before boot) makes that harmless.
#
#   Polling: every 2 s, up to 60 polls (120 s, D8); cloud-init first boot is
#   typically 20–40 s. When a lease matches, cross-check `virsh domstate`
#   is `running` (belt-and-braces, spec §4 step 5.2).
#
#   Fallbacks (best-effort, in order, ONLY when the lease file is absent /
#   unreadable / empty — spec §4 step 5.5, pitfall 2 keeps `virsh domifaddr`
#   strictly behind the lease file):
#     1. `virsh domifaddr $NAME` (default ARP source; unreliable until the
#        guest ARP-announces — retried every 2 s up to 60 s)
#     2. `arp -n | grep -i $MAC`
#
#   D6/AC3: the §3.1 success block is printed ONLY after the lease AND a
#   proven `ssh ... exit 0` (retried every 2 s up to ~90 s; ticket 07
#   hardened D8's ~60 s window). On any timeout:
#   exit 1 with a clear error naming `virsh console <NAME>`.
# ---------------------------------------------------------------------------

# find_ip_for_mac LEASE_FILE MAC -> prints the IP for that MAC, or nothing
# (no match is non-fatal). Self-contained (no globals) so fixture tests can
# eval it in isolation.
find_ip_for_mac() {
  local mac
  # Lowercase the query MAC (awk tolower()/jq ascii_downcase cover the file
  # side; tr covers the query side — the bash `tolower` builtin is missing
  # on this host's bash 5.2.21).
  mac="$(printf '%s' "$2" | tr 'A-Z' 'a-z')"
  # JSON lease file (CONFIRMED format on this host — see Step 5 header):
  if head -c1 "$1" 2>/dev/null | grep -q '\['; then
    if command -v jq >/dev/null 2>&1; then
      jq -r --arg mac "$mac" \
        '.[]? | select(((."mac-address" // "") | ascii_downcase) == $mac) | .["ip-address"]' \
        "$1" 2>/dev/null | head -n1
    else
      python3 -c '
import json, sys
try:
    leases = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
mac = sys.argv[2].lower()
for lease in leases:
    if isinstance(lease, dict) and str(lease.get("mac-address", "")).lower() == mac:
        print(lease.get("ip-address", ""))
        break
' "$1" "$mac" 2>/dev/null
    fi
    return 0
  fi
  # Legacy column format: `<ip> <mac> [<hostname>]` — the IP is the field
  # immediately before the (case-insensitive matched) MAC field.
  awk -v mac="$mac" '
    {
      n = split($0, f, /[ \t]+/)
      for (i = 2; i <= n; i++) {
        if (tolower(f[i]) == mac) { print f[i - 1]; exit }
      }
    }
  ' "$1" 2>/dev/null
}

# fallback_ip NAME MAC -> best-effort IP via domifaddr (retry) then arp -n.
fallback_ip() {
  local name="$1" mac="$2" ip attempt
  for (( attempt = 1; attempt <= 30; attempt++ )); do
    ip="$(virsh domifaddr "$name" 2>/dev/null | awk 'NF >= 3 { print $3 }' | grep -E '^[0-9.]+$' | head -n1 || true)"
    if [[ -n "$ip" ]]; then
      echo "$ip"
      return 0
    fi
    sleep 2
  done
  ip="$(arp -n 2>/dev/null | awk -v m="$(printf '%s' "$mac" | tr 'A-Z' 'a-z')" '{ for (i = 1; i <= NF; i++) if (tolower($i) == m) { print $1; exit } }' || true)"
  if [[ -n "$ip" ]]; then
    echo "$ip"
    return 0
  fi
  return 1
}

# wait_for_ip NAME MAC -> prints the IP; returns 1 if none in time.
wait_for_ip() {
  local name="$1" mac="$2" ip attempt
  local lease_usable=1
  [[ -r "$LEASE_FILE" ]] || lease_usable=0

  for (( attempt = 1; lease_usable && attempt <= 60; attempt++ )); do
    if [[ -s "$LEASE_FILE" ]]; then
      ip="$(find_ip_for_mac "$LEASE_FILE" "$mac")" || ip=""
      if [[ -n "$ip" ]]; then
        # Belt-and-braces cross-check (spec §4 step 5.2): the lease implies
        # the guest is up; confirm the domain state agrees.
        if [[ "$(virsh domstate "$name" 2>/dev/null || true)" == "running" ]]; then
          echo "$ip"
          return 0
        fi
      fi
    fi
    sleep 2
  done

  # Best-effort fallbacks: lease file absent, unreadable, or still empty.
  if [[ ! -r "$LEASE_FILE" || ! -s "$LEASE_FILE" ]]; then
    if ip="$(fallback_ip "$name" "$mac")"; then
      echo "$ip"
      return 0
    fi
  fi
  return 1
}

# verify_ssh_reachable NAME IP -> exit 0 iff `ssh ... exit` succeeds within
# ~90 s (45 attempts x 2 s).
#
# Hardening (ticket 07): D8's window was ~60 s (30 attempts). Ticket 06
# observed one real boot where the guest needed slightly longer than the
# built-in 60 s SSH window (vm-create exited 1 after printing the IP). The
# window is widened to ~90 s; everything else (2 s cadence, accept-new,
# BatchMode, success block only after proven SSH) is unchanged.
verify_ssh_reachable() {
  local attempt
  for (( attempt = 1; attempt <= 45; attempt++ )); do
    if ssh -o ConnectTimeout=2 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        "${USER_NAME}@$2" exit 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

IP="$(wait_for_ip "$NAME" "$MAC")" \
  || die "no DHCP lease after 120s — check: virsh console ${NAME}"
echo "IP acquired: ${IP}"

# Mandatory SSH verification (D6/AC3) — the success block below is printed
# only if this succeeds.
verify_ssh_reachable "$NAME" "$IP" \
  || die "SSH to ${USER_NAME}@${IP} not reachable yet — check: virsh console ${NAME}"

# ---------------------------------------------------------------------------
# Step 6 — print the exact §3.1 success block (D9: format is authoritative).
# ---------------------------------------------------------------------------
# NOTE: the spec's literal `awk '/UUID/ {print $3}'` yields an empty string
# on this host's virsh ("UUID:  <uuid>" is $1=$2, not $1..$3); $NF is robust
# to either spacing (ticket 05, minor deviation).
DOMAIN_UUID="$(virsh dominfo "$NAME" | awk '/UUID/ {print $NF}')"

cat <<EOF
VM created and running.
Name:    ${NAME}   (UUID ${DOMAIN_UUID})
IP:      ${IP}   (also reachable as ${NAME}.default)
SSH:     ssh ${USER_NAME}@${IP}
Console: virsh console ${NAME}     (Ctrl-] to detach)
Teardown: vm-destroy ${NAME}   (or: virsh destroy ${NAME} && virsh undefine ${NAME})
EOF
